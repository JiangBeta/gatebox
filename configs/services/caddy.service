[Unit]
Description=GateBox Caddy reverse proxy
Documentation=https://github.com/JiangBeta/gatebox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 低端口(80/443)能力由 systemd 授予,与二进制文件能力无关——
# 因此替换 caddy 制品(如 Caddy-L4 插件)后无需再 `setcap`,重装插件只需重启本服务。
User=gatebox
Group=gatebox
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/gatebox
ExecStart=/opt/gatebox/tools/caddy/caddy run --config /opt/gatebox/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
