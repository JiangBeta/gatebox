#!/bin/sh /etc/rc.common
# GateBox procd 服务（OpenWrt）
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/gatebox
    procd_set_param env GATEBOX_DATA_DIR=/opt/gatebox
    procd_set_param env GATEBOX_ADDR=0.0.0.0:8080
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
